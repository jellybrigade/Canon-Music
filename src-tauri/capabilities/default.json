{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://musicbrainz.org/**" },
        { "url": "https://*.musicbrainz.org/**" },
        { "url": "https://query.wikidata.org/**" }
      ]
    }
  ]
}
