{
  "name": "canon",
  "private": true,
  "version": "0.58.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "biome check --write . && cd src-tauri && cargo fmt",
    "lint": "biome check .",
    "check": "bash scripts/run-local-checks.sh",
    "prepare": "git config core.hooksPath scripts/git-hooks || true"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "js-md5": "^0.9.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stackblur-canvas": "^3.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-md5": "^0.8.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
